    { position: 10, value: 'Waers1', label: 'Kaynak Para Birimi'  },
    { position: 20, value: 'Waers2', label: 'Hedef Para Birimi' ,hidden: true },
    { position: 30, value: 'Rate',   label: 'Kur ' },
    { position: 40, value: 'Kurtr',  label: 'TCMB Tarihi' },
    { position: 50, value: 'Instr',  label: 'Sisteme Giriş Tarihi' },
    { position: 60, value: 'Rundt',  label: 'Yaratma Tarihi' },
